{
  "name": "cat-fighter-ii",
  "productName": "Cat Fighter II",
  "version": "0.1.0",
  "description": "Cat Fighter II — The Farmhouse Warriors. A six-button arcade fighting game.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "serve": "python3 -m http.server 8123",
    "test": "node --test test/*.test.mjs",
    "dist:win": "electron-builder --win --x64",
    "dist:win32": "electron-builder --win --ia32",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.farmhousegetaways.catfighter",
    "productName": "Cat Fighter II",
    "copyright": "Copyright © 2026 Farmhouse Getaways",
    "directories": { "output": "dist" },
    "files": [
      "index.html",
      "css/**/*",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "!**/*.md"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "CatFighterII-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cat Fighter II"
    },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.games" },
    "linux": { "target": ["AppImage"], "category": "Game" }
  }
}
